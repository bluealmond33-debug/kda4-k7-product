{
  "name": "kda4-k7-product",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "K7 음성 상담 MVP — STT → 표준 계약 → PostgreSQL → 상담카드",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate:manifest": "node scripts/validate-active-manifest.mjs",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "validate:adapter": "node scripts/validate-adapter.mjs",
    "validate:frontend-contract": "node --experimental-strip-types scripts/validate-frontend-contract.mjs",
    "check": "npm run validate:manifest && npm run validate:contracts && npm run validate:adapter && npm run validate:frontend-contract && npm run build",
    "check:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-release-gates.ps1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.3",
    "vite": "^8.1.4"
  }
}
