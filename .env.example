# OpenAI API 키 (클라우드 모드용) — 절대 프론트엔드에 노출하지 말 것
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4o-mini

# 프론트엔드 CORS 허용 오리진 — 콤마로 여러 개(팀원 접속용 LAN IP 등) 추가 가능
FRONTEND_ORIGIN=http://localhost:3000
EXTRA_CORS_ORIGINS=

# Chroma 벡터DB 로컬 저장 경로
CHROMA_PERSIST_DIR=./data/chroma

# PostgreSQL (mvp-1.0 계약 저장용)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/k7_mvp

# 온프레미스 모드 — true면 OpenAI 대신 로컬 STT(faster-whisper)/로컬 LLM(Ollama)
USE_LOCAL_MODELS=true
LOCAL_WHISPER_MODEL=large-v3-turbo
LOCAL_WHISPER_DEVICE=cuda
LOCAL_WHISPER_COMPUTE_TYPE=float16
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5:7.8b

# 박정운 emotion_temperature 모델(격양도) — 파일 없으면 자동 스텁 폴백, 기본값 그대로 둬도 됨
EMOTION_TEMPERATURE_MODEL_PATH=app/services/k7modeling/models/emotion_temperature_demo_final_v4.joblib
EMOTION_TEMPERATURE_MODEL_SHA256=88e2c3f3e0d85497a3e59a84ac42835ccf8620aab999de27cdb9ff92fc27d4ac
