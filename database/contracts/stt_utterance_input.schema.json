{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k7.example/contracts/stt-utterance-input-1.0.schema.json",
  "title": "K7 STT Utterance Input",
  "description": "STT가 FastAPI 마스킹 경계로 전달하는 발화 계약이다. FastAPI는 transcript를 그대로 DB나 React에 전달하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "external_session_key",
    "sequence_no",
    "speaker_type",
    "transcript",
    "stt_confidence",
    "spoken_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "external_session_key": { "type": "string", "minLength": 1, "maxLength": 100 },
    "sequence_no": { "type": "integer", "minimum": 1 },
    "speaker_type": { "type": "string", "enum": ["customer", "system", "counselor"] },
    "transcript": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "stt_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "spoken_at": { "type": "string", "format": "date-time" }
  }
}
