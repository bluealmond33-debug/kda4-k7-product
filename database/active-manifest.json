{
  "status": "active",
  "contract_version": "mvp-1.1",
  "source_channel": "voice",
  "masking_enabled": false,
  "audio_processing": {
    "mode": "whole_file_batch",
    "streaming": false,
    "telephony_connected": false,
    "capture_output": "audio_file",
    "audio_retention": "transient_request_processing",
    "audio_object_storage": "not_in_mvp",
    "stt_input": "audio",
    "summary_input": "stt_text",
    "stt_processor": "provider_configured",
    "summary_processor": "provider_configured",
    "providers": {
      "cloud": {
        "stt": "openai",
        "analysis": "openai"
      },
      "local": {
        "stt": "faster_whisper",
        "analysis": "ollama"
      }
    },
    "emotion_input": "same_audio_file_only",
    "branching": "after_audio_capture",
    "correlation_key": "call_id",
    "call_id_created": "before_analysis",
    "branches": {
      "text_analysis": ["stt_provider", "analysis_provider"],
      "audio_emotion": ["audio_emotion_model"]
    },
    "parallel_execution_allowed": true,
    "join_before_persist": true,
    "emotion_result_policy": {
      "allowed_statuses": ["unavailable", "completed"],
      "demo_forbidden": true
    }
  },
  "adapter": {
    "implementation": "backend/app/model_adapter.py",
    "kind": "deterministic_code",
    "uses_ai": false
  },
  "database": {
    "engine": "postgresql",
    "schema": "database/mvp/schema.sql",
    "tables": ["calls", "transcripts", "consultation_cards"],
    "optional_extensions": {
      "regulation_rag": {
        "schema": "database/rag/schema.sql",
        "tables": ["rag_documents", "rag_chunks"],
        "required": false
      }
    }
  },
  "contracts": {
    "model_input": "database/contracts/model_consultation_result_input.schema.json",
    "audio_emotion_result": "database/contracts/emotion_temperature_result.schema.json",
    "audio_emotion_example": "database/contracts/examples/emotion_temperature_result.example.json",
    "model_postprocessing": "database/mvp/model_postprocessing.v1.json",
    "api_response": "database/contracts/mvp_call_response.schema.json",
    "example": "database/contracts/examples/mvp_call_response.example.json"
  },
  "backend": {
    "app": "backend/app/main.py",
    "pydantic_contracts": "backend/app/contracts.py",
    "model_adapter": "backend/app/model_adapter.py",
    "audio_emotion_adapter": "backend/app/emotion_adapter.py",
    "integration_service": "backend/app/integration_service.py",
    "database_gateway": "backend/app/database.py",
    "endpoints": [
      "POST /api/v1/calls",
      "GET /api/v1/calls/{call_id}/consultation-card",
      "GET /health"
    ]
  },
  "frontend": {
    "service": "src/services/consultation.ts",
    "response_validator": "src/services/consultationContract.ts",
    "types": "src/services/types.ts",
    "upload_ui": "src/components/LiveDemo.tsx"
  },
  "release_validation": {
    "gate": "scripts/check-release-gates.ps1",
    "database_verifier": "scripts/verify-active-database.py",
    "test_call_cleanup": "scripts/cleanup-test-call.py",
    "requires_real_audio": true,
    "database_row_policy": "restore_pre_smoke_counts"
  },
  "handoffs": {
    "audio_emotion_model": "docs/AUDIO_EMOTION_MODEL_HANDOFF.md"
  }
}
