K7_HTTP_PORT=8080
POSTGRES_USER=k7
POSTGRES_PASSWORD=change-this-demo-password
POSTGRES_DB=k7

# CPU-safe default. GPU laptops may use cuda/float16 after Docker GPU setup.
LOCAL_STT_MODEL=small
LOCAL_STT_DEVICE=cpu
LOCAL_STT_COMPUTE_TYPE=int8

# 2.4B is the CPU-laptop demo default. Use 7.8B only when slower, higher-quality
# generation is acceptable or GPU acceleration is configured.
OLLAMA_MODEL=exaone3.5:2.4b
OLLAMA_TIMEOUT_SEC=600

# Delivered NIA general-banking 10-topic model. This is not the measured
# accuracy of urgent/simple/general or the ARS 17-route rule layer.
ROUTING_TOPIC_ENABLED=true
ROUTING_TOPIC_MARGIN_THRESHOLD=0.75
ROUTING_TOPIC_MODEL_SHA256=0474677A2C335817F9F677A37077C3E56C81BD2CB3378E506B6479910A263832
