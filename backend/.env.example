OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
DATABASE_URL=postgresql://user:password@localhost:5432/k7
FRONTEND_ORIGIN=http://localhost:5173
EXTRA_CORS_ORIGINS=https://k7product.vercel.app
# Regulation RAG (optional). Default embedding backend is bge-m3 (onprem/local),
# used only when FlagEmbedding is installed; otherwise regulation search reports
# available=false and the panel falls back. K7_EMBED=static uses a light demo model.
K7_EMBED=bge-m3
